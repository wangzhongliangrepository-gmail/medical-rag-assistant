
# 医疗知识助手 —— 环境变量模板
# 用法：cp .env.example .env，然后把下面的占位符换成真实值。
# 真实的 .env 已被 .gitignore 排除，绝不会提交。

# ========== 必填：外部 API 密钥 ==========
# DeepSeek 云端 LLM（https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Tavily Web 搜索（https://tavily.com 注册免费获取）；不联网可留空，use_external 关掉即可
TAVILY_API_KEY=tvly-your-tavily-key-here

# ========== 部署接线（容器化时由 docker-compose 注入，本地开发按需设）==========
# Qdrant 向量库：设了就连服务器；留空则用本地落盘（QDRANT_PATH=./qdrant_db）
# 本机连容器：http://localhost:6333    app 容器内连 qdrant 容器：http://qdrant:6333
QDRANT_URL=http://localhost:6333

# Xinference（BGE 向量化 + 重排，跑在宿主机 GPU 上）
# 本机直连：http://localhost:9997     app 容器回连宿主机：http://host.docker.internal:9997
XINFERENCE_URL=http://localhost:9997

# ========== Xinference 模型 UID（用 `xinference list` 查，是 UID 不是模型名）==========
EMBED_MODEL_UID=bge-m3
RERANK_MODEL_UID=bge-reranker-v2-m3

# ========== 可选：模型分级（一般用默认即可）==========
# LLM_FLASH=deepseek-v4-flash
# LLM_PRO=deepseek-v4-pro

# ========== 可选：检索 / 记忆 / 反思调参（默认值见 config.py，按需覆盖）==========
# QDRANT_COLLECTION=medical_kb
# RECALL_K=20
# FUSE_TOP_K=6
# MAX_REVISIONS=2